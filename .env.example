# OpenAI provider used by the elicitation interview.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local application state. On Render, point these at the mounted /var/data disk.
ELICITATION_DB_PATH=elicitation.db
ELICITATION_LOG_PATH=logs/elicitation_pipeline.jsonl
DATASET_STORE_PATH=dataset_store
SCHEMA_VERSION=1.0.0
PROMPT_VERSION=llmrei-long-forecasting-v1

# Optional separately hosted Data Source Registry API.
# Local example: http://127.0.0.1:8000
# Render example: https://your-registry-service.onrender.com
REGISTRY_API_URL=
REGISTRY_API_KEY=
REGISTRY_REQUIRED=false
REGISTRY_TIMEOUT_SECONDS=10
REGISTRY_MAX_RETRIES=2
REGISTRY_MIN_RELEVANCE=0.80
REGISTRY_MIN_COMPANION_STRENGTH=0.60
REGISTRY_MAX_DEPENDENCY_DEPTH=2
REGISTRY_MAX_SOURCES=12
REGISTRY_INCLUDE_PENDING=false
